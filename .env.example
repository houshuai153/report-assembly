# 生产部署配置：复制为 .env 并修改（docker-compose.prod.yml 会读取）
#   cp .env.example .env

# 你的域名（Caddy 会自动签发 HTTPS 证书）
DOMAIN=report.example.com

# 访问密码（登录用，务必改成强密码）
APP_PASSWORD=change-me

# 会话签名密钥（务必改成强随机值，例如 `openssl rand -hex 32`）
APP_SECRET=change-me-in-prod

# LLM：mock（演示）或 openai_compatible（私有化部署）
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_ID=mock-llm-1
